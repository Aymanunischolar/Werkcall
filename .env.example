# Copy to .env and fill in only what you need. The browser demo runs with
# zero external accounts using VOICE_PROVIDER=mock and no Supabase/HubSpot
# credentials (see backend/app/db/memory.py, backend/app/services/*.py).
# Never commit a real .env file — see SECURITY.md.

ENVIRONMENT=development
LOG_LEVEL=INFO

# gemini_live (free-first default) | openai_realtime (optional, paid) | mock (offline demo)
VOICE_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Supabase (leave blank to use the in-memory repository — app/db/memory.py)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Calendar OAuth (leave blank to use the in-memory calendar stand-in)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# HubSpot (leave blank to use the in-memory CRM stand-in)
HUBSPOT_PRIVATE_APP_TOKEN=

# Gmail (used by the n8n booking-confirmation workflow, not by the backend directly)
GMAIL_SENDER_ADDRESS=

# n8n (leave blank to skip post-call automation entirely)
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SIGNING_SECRET=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
DEMO_OPERATOR_EMAIL=

# Twilio trial (optional telephone channel, add only after the browser demo works)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_NUMBER=

# Security
ALLOWED_ORIGINS=http://localhost:5173
SESSION_RATE_LIMIT_PER_MINUTE=20
DEMO_DATA_RETENTION_DAYS=7
STORE_RAW_AUDIO=false
