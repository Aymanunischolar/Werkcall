      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SIGNING_SECRET;\nconst timestamp = $input.first().json.headers['x-werkcall-timestamp'];\nconst signature = $input.first().json.headers['x-werkcall-signature'];\nconst rawBody = JSON.stringify($input.first().json.body);\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nconst freshEnough = Math.abs(Date.now() / 1000 - Number(timestamp)) < 300;\nreturn [{ json: { ...$input.first().json.body, _signatureValid: signature === expected && freshEnough } }];"
      },
      "id": "1a1b1c1d-0006-4a1a-8a1a-000000000006",
      "name": "Verify signature and timestamp",
      "type": "n8n-nodes-base.code",
